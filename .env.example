# Postgres connection string. Any standard host works (Vercel Postgres,
# Neon, Supabase, Railway, RDS, self-hosted, or a local Postgres for dev).
DATABASE_URL="postgresql://user:password@localhost:5432/leiva_group"

# Admin login for /admin — a single shared operator credential.
ADMIN_USERNAME="RayRay"
ADMIN_PASSWORD="change-me"

# Random string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Resend (https://resend.com) API key for booking-confirmation emails.
# Leave blank to skip sending email — bookings still save to the database.
RESEND_API_KEY=""
NOTIFY_EMAIL="hello.leivagroup@gmail.com"
